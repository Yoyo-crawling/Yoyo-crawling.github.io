8:["$","section",null,{"className":"panel","id":"experience","children":[["$","div",null,{"className":"section-heading","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"EXPERIENCE"}],["$","h2",null,{"children":"实习经历"}]]}],["$","span",null,{"className":"section-index","children":"02"}]]}],["$","div",null,{"className":"experience-list","children":[["$","$L6","shanghai-metals-market",{"className":"experience-card experience-link","href":"/experience/shanghai-metals-market","children":[["$","div",null,{"className":"experience-topline","children":[["$","span",null,{"children":"2026.05 — 至今"}],["$","strong",null,{"children":"行研实习生"}]]}],["$","h3",null,{"children":"上海有色网"}],["$","p",null,{"className":"team-name","children":"研究院 Research Institute"}],["$","ul",null,{"children":[["$","li","针对不同镍点 NPI 缺少可比经济性判断的问题，独立搭建 304 不锈钢原料经济性模型，整合 5 类原料的条件约束。",{"children":"针对不同镍点 NPI 缺少可比经济性判断的问题，独立搭建 304 不锈钢原料经济性模型，整合 5 类原料的条件约束。"}],["$","li","汇集供需、库存、贸易、矿山及冶炼资产等外部数据，完成全球镍年度数据包 36 个工作表的更新、口径统一与公式维护。",{"children":"汇集供需、库存、贸易、矿山及冶炼资产等外部数据，完成全球镍年度数据包 36 个工作表的更新、口径统一与公式维护。"}],["$","li","跟踪镍价、库存、供需、不锈钢需求与印尼政策等变量，为行业动态跟踪和商业分析提供数据基础。",{"children":"跟踪镍价、库存、供需、不锈钢需求与印尼政策等变量，为行业动态跟踪和商业分析提供数据基础。"}],["$","li","使用 PPT、Excel 完成镍掉期产品材料的版式设计、图表呈现与数据可视化。",{"children":"使用 PPT、Excel 完成镍掉期产品材料的版式设计、图表呈现与数据可视化。"}]]}],["$","span",null,{"className":"detail-link","children":"查看完整经历 →"}]]}],["$","$L6","foshan-platform-consulting",{"className":"experience-card experience-link","href":"/experience/foshan-platform-consulting","children":[["$","div",null,{"className":"experience-topline","children":[["$","span",null,{"children":"2026.01 — 2026.03"}],["$","strong",null,{"children":"实习咨询顾问"}]]}],["$","h3",null,{"children":"深圳市创业投资同业公会"}],["$","p",null,{"className":"team-name","children":"佛山优选平台战略咨询项目"}],["$","ul",null,{"children":[["$","li","基于公开统计与第三方报告开展行业研究和市场研究，拆解泛家居出海趋势、政策约束与竞争格局。",{"children":"基于公开统计与第三方报告开展行业研究和市场研究，拆解泛家居出海趋势、政策约束与竞争格局。"}],["$","li","参与 10+ 家企业访谈及纪要整理，归纳获客、履约、政策三类痛点，并整理为平台能力建设需求清单。",{"children":"参与 10+ 家企业访谈及纪要整理，归纳获客、履约、政策三类痛点，并整理为平台能力建设需求清单。"}],["$","li","针对三大痛点，独立搭建“一站式赋能平台”战略规划框架，输出核心功能模块与分阶段推进路径设计。",{"children":"针对三大痛点，独立搭建“一站式赋能平台”战略规划框架，输出核心功能模块与分阶段推进路径设计。"}],["$","li","完成 7 份 PPT 的内容结构化与关键页撰写，将研究结论转化为项目汇报材料。",{"children":"完成 7 份 PPT 的内容结构化与关键页撰写，将研究结论转化为项目汇报材料。"}]]}],["$","span",null,{"className":"detail-link","children":"查看完整经历 →"}]]}],["$","$L6","country-market-entry",{"className":"experience-card experience-link","href":"/experience/country-market-entry","children":[["$","div",null,{"className":"experience-topline","children":[["$","span",null,{"children":"2025.10 — 2025.12"}],["$","strong",null,{"children":"研究助理"}]]}],["$","h3",null,{"children":"武汉长贸数字产业有限公司"}],["$","p",null,{"className":"team-name","children":"国别市场分析项目"}],["$","ul",null,{"children":[["$","li","搭建日本、德国、阿根廷 3 国进入评估框架，覆盖国家概况、外贸结构、FDI、法规政策与产业结构。",{"children":"搭建日本、德国、阿根廷 3 国进入评估框架，覆盖国家概况、外贸结构、FDI、法规政策与产业结构。"}],["$","li","汇总公开统计与第三方报告，形成关键指标口径、风险提示和进入优先级研判证据。",{"children":"汇总公开统计与第三方报告，形成关键指标口径、风险提示和进入优先级研判证据。"}],["$","li","结合武汉产业基础与目标国市场特征，形成出海路径与产业匹配建议清单。",{"children":"结合武汉产业基础与目标国市场特征，形成出海路径与产业匹配建议清单。"}]]}],["$","span",null,{"className":"detail-link","children":"查看完整经历 →"}]]}],["$","$L6","international-audit",{"className":"experience-card experience-link","href":"/experience/international-audit","children":[["$","div",null,{"className":"experience-topline","children":[["$","span",null,{"children":"2025.01 — 2025.05"}],["$","strong",null,{"children":"审计助理"}]]}],["$","h3",null,{"children":"天职国际会计师事务所（总所）"}],["$","p",null,{"className":"team-name","children":"国际业务部"}],["$","ul",null,{"children":[["$","li","参与多家国际审计项目的底稿编制，按照项目要求整理和核对审计证据。",{"children":"参与多家国际审计项目的底稿编制，按照项目要求整理和核对审计证据。"}],["$","li","负责凭证抽样与往来函证相关工作，协助完成关键财务信息核验。",{"children":"负责凭证抽样与往来函证相关工作，协助完成关键财务信息核验。"}],["$","li","对财务数据进行结构化处理与核对，提升对财务数据的敏感度。",{"children":"对财务数据进行结构化处理与核对，提升对财务数据的敏感度。"}]]}],["$","span",null,{"className":"detail-link","children":"查看完整经历 →"}]]}]]}]]}]
